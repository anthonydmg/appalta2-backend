# =====================================================================
# Appalta2 backend — plantilla de variables de entorno (única, se versiona en git)
#
#   cp .env.example .env              -> desarrollo local (run.ps1 lo crea si no existe)
#   cp .env.example .env.production   -> servidor con Docker Compose
#
# Ninguno de los dos se sube al repositorio.
#   1. Reemplaza cada valor "REEMPLAZAR_..." (en producción la API no arranca si queda alguno).
#   2. En .env.production usa los valores marcados [PROD].
#   3. Verifica:  python -m scripts.check_env .env.production
# Las líneas comentadas muestran el valor por defecto (no hace falta definirlas).
# Detalle de cada variable: app/config/environment.py · Despliegue: DEPLOY.md
# =====================================================================

# ---------------------------------------------------------------------
# Aplicación
# ---------------------------------------------------------------------
# development | production
# [PROD] production -> exige JWT_SECRET_KEY segura y cierra Swagger (/docs)
APP_ENV=development
# URL pública del API, sin "/v1": los enlaces de los correos son {PUBLIC_API_URL}/v1/user/...
# [PROD] https://proyectos-didt.inictel-uni.edu.pe/api/palta   (el proxy redirige /api/palta/ -> /api/)
PUBLIC_API_URL=http://localhost:8000/api
# Swagger y OpenAPI (/docs, /redoc, /openapi.json). Por defecto: true en development, false en production
# API_DOCS_ENABLED=

# ---------------------------------------------------------------------
# Base de datos (PostgreSQL 14+)
# ---------------------------------------------------------------------
# postgresql+psycopg2://USUARIO:CLAVE@HOST:PUERTO/BASE   (o postgresql+pg8000://... en Windows)
# [PROD] host.docker.internal si PostgreSQL corre en el mismo servidor que Docker
DATABASE_URL=postgresql+psycopg2://postgres:REEMPLAZAR_CLAVE_POSTGRES@localhost:5432/appalta2
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20

# ---------------------------------------------------------------------
# Autenticación (JWT)
# ---------------------------------------------------------------------
# Generar:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# [PROD] obligatoria (32+ caracteres). Al cambiarla, los usuarios vuelven a iniciar sesión.
JWT_SECRET_KEY=REEMPLAZAR_CLAVE_ALEATORIA_DE_48_CARACTERES
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------
# Correo (SMTP) — verificación de cuenta y recuperación de contraseña
# ---------------------------------------------------------------------
# Gmail: MAIL_PASSWORD es una "contraseña de aplicación" de 16 caracteres, no la normal
# (Cuenta de Google -> Seguridad -> Verificación en 2 pasos -> Contraseñas de aplicaciones)
MAIL_USERNAME=REEMPLAZAR_correo@gmail.com
MAIL_PASSWORD=REEMPLAZAR_CONTRASENA_DE_APLICACION
# MAIL_FROM=            # vacío = MAIL_USERNAME
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_STARTTLS=true
# MAIL_SSL_TLS=false
# MAIL_USE_CREDENTIALS=true

# ---------------------------------------------------------------------
# Asistente IA (app/assistant) — todo opcional
# ---------------------------------------------------------------------
# [PROD] LLM_BASE_URL la fija docker-compose.yml (http://ollama:11434)
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=gemma4:e2b
# Generaciones simultáneas (= OLLAMA_NUM_PARALLEL en docker-compose.yml); en CPU 1–2
# LLM_MAX_CONCURRENCY=2
# LLM_QUEUE_TIMEOUT_SECONDS=60
# LLM_TIMEOUT_SECONDS=180
# TIMEZONE=America/Lima

# ---------------------------------------------------------------------
# Docker Compose (solo .env.production; no las lee la API)
# ---------------------------------------------------------------------
# Puerto publicado en el servidor (el proxy HTTPS apunta aquí)
# BACKEND_PORT=8000
