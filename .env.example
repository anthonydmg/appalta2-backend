# =====================================================================
# Appalta2 backend — plantilla de variables de entorno (única, se versiona en git)
#
#   .env             desarrollo local (run.ps1 lo crea a partir de esta plantilla)
#   .env.production  servidor con Docker:  docker compose --env-file .env.production up -d --build
#
# Ninguno de los dos se sube al repositorio. Las líneas comentadas muestran el valor
# por defecto (no hace falta definirlas). Detalle de cada variable: app/config/settings.py
# Marcado [PROD]: valor o cambio necesario en .env.production.
# =====================================================================

# ---------------------------------------------------------------------
# Aplicación
# ---------------------------------------------------------------------
# development | production   [PROD] production: la API no arranca sin JWT_SECRET_KEY segura
APP_ENV=development
# URL pública del API, sin "/v1": los enlaces de los correos son {PUBLIC_API_URL}/v1/user/...
# [PROD] https://proyectos-didt.inictel-uni.edu.pe/api/palta  (el proxy redirige /api/palta/ -> /api/)
PUBLIC_API_URL=http://localhost:8000/api

# ---------------------------------------------------------------------
# Base de datos (PostgreSQL)
# ---------------------------------------------------------------------
# Driver psycopg2 o pg8000 (Python puro, útil en Windows con Smart App Control)
# [PROD] postgresql+psycopg2://USUARIO:CONTRASEÑA@HOST:5432/appalta2
#        (PostgreSQL en el mismo servidor que Docker: host.docker.internal)
DATABASE_URL=postgresql+pg8000://postgres:CONTRASEÑA@localhost:5432/appalta2
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20

# ---------------------------------------------------------------------
# Autenticación (JWT)
# ---------------------------------------------------------------------
# Generar: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Vacía en desarrollo: se usa una clave insegura y se avisa en el log.
# [PROD] obligatoria. Al cambiarla, los usuarios deben volver a iniciar sesión en la app.
JWT_SECRET_KEY=
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------
# Correo (SMTP) — verificación de cuenta y recuperación de contraseña
# ---------------------------------------------------------------------
# Gmail: MAIL_PASSWORD es una "contraseña de aplicación" (16 caracteres), no la normal.
MAIL_USERNAME=correo@gmail.com
MAIL_PASSWORD=
# MAIL_FROM=            # vacío = MAIL_USERNAME
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_STARTTLS=true
# MAIL_SSL_TLS=false
# MAIL_USE_CREDENTIALS=true

# ---------------------------------------------------------------------
# Asistente IA (app/assistant) — todo opcional
# ---------------------------------------------------------------------
# [PROD] LLM_BASE_URL la fija docker-compose.yml (http://ollama:11434)
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=gemma4:e2b
# Igual a OLLAMA_NUM_PARALLEL (docker-compose.yml lo toma de aquí); en CPU 1–2
# LLM_MAX_CONCURRENCY=2
# LLM_QUEUE_TIMEOUT_SECONDS=60
# LLM_TIMEOUT_SECONDS=180
# TIMEZONE=America/Lima

# ---------------------------------------------------------------------
# Docker Compose (solo .env.production; no las lee la API)
# ---------------------------------------------------------------------
# Puerto publicado en el servidor (el proxy HTTPS apunta aquí)
# BACKEND_PORT=8000
